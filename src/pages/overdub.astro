    </div>
    <div class="lightbox" id="lb-overdub-06">
      <a class="lightbox__scrim" href="#step-6" aria-label="Close"></a>
      <div class="lightbox__stage"><img fetchpriority="low" src="/images/portfolio-review/Boombox-overdub-06.png" alt="Save your recording sheet"></div>
      <a class="lightbox__nav lightbox__nav--prev" href="#lb-overdub-05" aria-label="Previous image"></a>
