---

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Sage Baggott</h1>
    <p class="tagline">Drummer / Percussionist / Composer</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('/images/hero-bg.jpg') center center / cover no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  .hero-content {
    position: relative;
    text-align: center;
    z-index: 1;
    padding: 0 20px;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 6px;
    margin-bottom: 15px;
  }

  .tagline {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: var(--text-muted);
    letter-spacing: 3px;
    text-transform: uppercase;
  }
</style>
