---

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Sage<br />Baggott</h1>
    <p class="tagline">
        Drummer /
        <br />
        Percussionist /
        <br />
        Composer
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: left;
    background: url('/images/hero-bg.jpg') top center / cover no-repeat;
    transition: all 0.3s ease;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  .hero-content {
    position: relative;
    text-align: left;
    z-index: 1;
    padding: 0 20px 0 10%;
  }

  .hero-content h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
    line-height: 0.73;
    color: var(--accent);
  }

  .tagline {
    font-size: clamp(2rem, 2.5vw, 1.4rem);
    text-transform: uppercase;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .hero {
      height: 70vh;
    }
  }
</style>
