---

---

<section id="contact" class="contact">
  <div class="container">
    <h2 class="section-title">Contact</h2>
    <p class="contact-intro">Sign up for news about upcoming shows (or just say hi)</p>
    <form
      class="contact-form"
      action="https://sagebaggott.us7.list-manage.com/subscribe/post?u=e763e4406fd844f54fc6a71e1&amp;id=d290a84b43"
      method="POST"
      id="mc-form"
    >
      <div class="form-row">
        <div class="form-group">
          <label for="mce-FNAME">First name <span class="required">*</span></label>
          <input type="text" id="mce-FNAME" name="FNAME" required />
        </div>
        <div class="form-group">
          <label for="mce-LNAME">Last name</label>
          <input type="text" id="mce-LNAME" name="LNAME" />
        </div>
      </div>
      <div class="form-group">
        <label for="mce-EMAIL">Email <span class="required">*</span></label>
        <input type="email" id="mce-EMAIL" name="EMAIL" required />
      </div>
      <div class="form-group">
        <label for="mce-MESSAGE">Message</label>
        <textarea id="mce-MESSAGE" name="MESSAGE" rows="5"></textarea>
      </div>
      <!-- Tag: "gigs" -->
      <input type="hidden" name="tags" value="3642684" />
      <!-- Bot signup protection -->
      <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input type="text" name="b_e763e4406fd844f54fc6a71e1_d290a84b43" tabindex="-1" value="" />
      </div>
      <button type="submit">Subscribe</button>
      <p class="form-status" id="form-status"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--bg-light);
  }

  .contact-intro {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 40px;
    font-size: 1.05rem;
  }

  .contact-form {
    max-width: 700px;
    margin: 0 auto;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .required {
    color: var(--accent);
    font-size: 1.2rem;
  }

  input, textarea {
    width: 100%;
    padding: 12px 16px;
    background: var(--bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: var(--text);
    transition: border-color 0.3s ease;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  textarea {
    resize: vertical;
  }

  button[type="submit"] {
    display: block;
    width: 100%;
    padding: 14px;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 4px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  button[type="submit"]:hover {
    background: var(--accent-secondary);
    color: var(--text);
  }

  .form-status {
    text-align: center;
    margin-top: 16px;
    font-size: 0.95rem;
  }

  .form-status.success {
    color: #4caf50;
  }

  .form-status.error {
    color: #f44336;
  }

  @media (min-width: 768px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('mc-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Subscribing...';
    status.className = 'form-status';

    const data = new FormData(form);
    const params = new URLSearchParams(data as any).toString();

    // Use Mailchimp's JSONP endpoint to stay on-page
    const url = form.action.replace('/post?', '/post-json?') + '&' + params + '&c=callback';

    try {
      const response = await fetch(url, { mode: 'no-cors' });
      status.textContent = 'Thanks for subscribing!';
      status.className = 'form-status success';
      form.reset();
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'form-status error';
    }
  });
</script>
